
"""
Seaborn Statistical Data Visualization

In this project, I explore student performance data using
Seaborn. I created different plots to understand score trends,
compare subject averages, view score distributions, identify
possible outliers, and explore attendance versus marks.
"""

import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt

# Use a clean and consistent style for all graphs
sns.set_theme(style="whitegrid")

# Sample student performance dataset
data = {
    "Student": [
        "Aarav", "Priya", "Rohan", "Sneha", "Kabir",
        "Meera", "Ishaan", "Ananya", "Rahul", "Neha",
        "Arjun", "Pooja"
    ],
    "Subject": [
        "Python", "Python", "Python", "Python",
        "C++", "C++", "C++", "C++",
        "DBMS", "DBMS", "DBMS", "DBMS"
    ],
    "Marks": [75, 92, 68, 85, 78, 95, 62, 88, 80, 90, 72, 98],
    "Attendance": [80, 96, 72, 88, 84, 98, 65, 91, 82, 95, 75, 99],
    "Study_Hours": [2, 5, 1, 4, 3, 6, 1, 5, 3, 5, 2, 7]
}

df = pd.DataFrame(data)

print("=" * 50)
print("   SEABORN STATISTICAL DATA VISUALIZATION")
print("=" * 50)

print("\nStudent Dataset:")
print(df)

# Create a figure with five statistical plots
fig, axes = plt.subplots(3, 2, figsize=(14, 16))
fig.suptitle(
    "Student Performance Statistical Analysis",
    fontsize=18,
    fontweight="bold"
)

# 1. Line plot: Marks across students
sns.lineplot(
    data=df,
    x="Student",
    y="Marks",
    marker="o",
    ax=axes[0, 0],
    label="Student Marks"
)
axes[0, 0].set_title("Marks Trend Across Students")
axes[0, 0].set_xlabel("Student")
axes[0, 0].set_ylabel("Marks")
axes[0, 0].tick_params(axis="x", rotation=45)
axes[0, 0].legend()

# 2. Bar plot: Average marks for each subject
sns.barplot(
    data=df,
    x="Subject",
    y="Marks",
    hue="Subject",
    legend=False,
    ax=axes[0, 1]
)
axes[0, 1].set_title("Average Marks by Subject")
axes[0, 1].set_xlabel("Subject")
axes[0, 1].set_ylabel("Average Marks")

# 3. Histogram: Distribution of marks
sns.histplot(
    data=df,
    x="Marks",
    bins=6,
    kde=True,
    ax=axes[1, 0]
)
axes[1, 0].set_title("Distribution of Student Marks")
axes[1, 0].set_xlabel("Marks")
axes[1, 0].set_ylabel("Number of Students")

# 4. Box plot: Marks grouped by subject
sns.boxplot(
    data=df,
    x="Subject",
    y="Marks",
    ax=axes[1, 1]
)
axes[1, 1].set_title("Marks Spread by Subject")
axes[1, 1].set_xlabel("Subject")
axes[1, 1].set_ylabel("Marks")

# 5. Scatter plot: Attendance versus marks
sns.scatterplot(
    data=df,
    x="Attendance",
    y="Marks",
    hue="Subject",
    s=100,
    ax=axes[2, 0]
)
axes[2, 0].set_title("Attendance vs Marks")
axes[2, 0].set_xlabel("Attendance (%)")
axes[2, 0].set_ylabel("Marks")
axes[2, 0].legend(title="Subject")

# Keep the sixth subplot empty because we have five plots
axes[2, 1].axis("off")

# Improve spacing and save the complete dashboard
plt.tight_layout(rect=[0, 0, 1, 0.97])
plt.savefig("seaborn_dashboard.png", dpi=300, bbox_inches="tight")
plt.show()

# Print a few useful statistics
print("\nAverage Marks by Subject:")
print(df.groupby("Subject")["Marks"].mean().round(2))

print("\nOverall Average Marks:", round(df["Marks"].mean(), 2))
print("\nDashboard saved as seaborn_dashboard.png")
print("Analysis completed successfully!")

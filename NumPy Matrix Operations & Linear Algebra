
"""
NumPy Matrix Operations and Linear Algebra

I created this project to practice matrix operations using NumPy.
It covers solving linear equations, finding matrix inverses,
calculating transposes, and finding eigenvalues and eigenvectors.
"""

import numpy as np

np.set_printoptions(precision=3, suppress=True)

print("=" * 55)
print("       NUMPY MATRIX OPERATIONS & LINEAR ALGEBRA")
print("=" * 55)

# 1. Create a matrix
A = np.array([
    [2, 1],
    [1, 3]
], dtype=float)

print("\n1. Original Matrix A:")
print(A)

# 2. Solve a system of linear equations
# 2x + y = 5
# x + 3y = 7

coefficients = np.array([
    [2, 1],
    [1, 3]
], dtype=float)

constants = np.array([5, 7], dtype=float)

solution = np.linalg.solve(coefficients, constants)

print("\n2. Solution of Linear Equations:")
print("Equations: 2x + y = 5 and x + 3y = 7")
print("Solution [x, y]:", solution)

# 3. Find the inverse of a matrix
inverse_A = np.linalg.inv(A)

print("\n3. Inverse of Matrix A:")
print(inverse_A)

# Verify the inverse: A multiplied by A inverse
print("\nVerification (A @ inverse of A):")
print(A @ inverse_A)

# 4. Find the transpose of a matrix
transpose_A = A.T

print("\n4. Transpose of Matrix A:")
print(transpose_A)

# 5. Find eigenvalues and eigenvectors
eigenvalues, eigenvectors = np.linalg.eig(A)

print("\n5. Eigenvalues of Matrix A:")
print(eigenvalues)

print("\n6. Eigenvectors of Matrix A:")
print(eigenvectors)

# 7. Display some additional matrix properties
print("\n7. Additional Matrix Information:")
print("Shape:", A.shape)
print("Determinant:", round(np.linalg.det(A), 3))
print("Trace:", np.trace(A))

print("\nAll matrix operations completed successfully!")
